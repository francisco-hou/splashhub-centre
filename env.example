# Local preview needs none of these: `python app/server.py` runs on SQLite with sample data.
#
# On Spluki the platform injects the database (SPLUKI_POSTGRES grant) and the sealed secret:
#   DATABASE_WRITER_HOST, DATABASE_READER_HOST, DATABASE_PORT, DATABASE_NAME, DATABASE_USER, DATABASE_PASSWORD
#   ADMIN_PASSWORD
# Never write real values into this file or into the tree.

# Port and bind address (the container sets HOST=0.0.0.0).
PORT=8795
HOST=127.0.0.1

# Local only: 0 starts with an empty log instead of sample runs.
SAMPLE_DATA=1

# Local only: set to try the sign-in screen (or put it in app/admin_password.txt, gitignored).
# ADMIN_PASSWORD=
